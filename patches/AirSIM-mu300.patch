+package main
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestMU300MixedVoiceModeKeepsRingingCall(t *testing.T) {
+	mode, state := 0, 2
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		if command != "AT+CLCC" {
+			t.Fatalf("unexpected command %s", command)
+		}
+		return fmt.Sprintf("+CLCC: 1,0,%d,%d,0,\"15550001111\",129\nOK", state, mode), nil
+	})
+	_, _ = a.mu300RefreshCalls()
+	id := a.calls.Active.ID
+	mode, state = 3, 3
+	for i := 0; i < 3; i++ {
+		calls, err := a.mu300PollRefreshCalls()
+		if err != nil || len(calls) != 1 || calls[0].State != "alerting" {
+			t.Fatalf("real modem voice-mode alerting row was filtered: calls=%v err=%v", calls, err)
+		}
+	}
+	mode, state = 0, 0
+	_, _ = a.mu300PollRefreshCalls()
+	if a.calls.Active.ID != id || a.calls.Active.State != "active" || len(a.calls.History) != 0 {
+		t.Fatal("mode transition ended or replaced the call")
+	}
+}
+
+func TestMU300CLCCVoiceModesStayProfileScoped(t *testing.T) {
+	for mode := 0; mode <= 9; mode++ {
+		t.Run(fmt.Sprint(mode), func(t *testing.T) {
+			response := fmt.Sprintf("+CLCC: 1,1,4,%d,0,\"15550001111\",129\nOK", mode)
+			a := testMU300Calls(t, func(string, time.Duration) (string, error) { return response, nil })
+			calls, err := a.mu300RefreshCalls()
+			wantVoice := mode == 0 || mode == 3 || mode == 4 || mode == 5
+			if err != nil || (len(calls) == 1) != wantVoice {
+				t.Fatalf("mode %d: calls=%v err=%v", mode, calls, err)
+			}
+			if (len(parseCLCC(response)) == 1) != (mode == 0) {
+				t.Fatal("MU300 fix changed other platform parsing")
+			}
+		})
+	}
+}
+
+func TestMU300AlertingGapKeepsOutgoingIdentity(t *testing.T) {
+	a := testMU300Calls(t, nil)
+	now := time.Now()
+	setup := parsedCall{Index: 1, Direction: "outgoing", State: "alerting", Number: "15550001111"}
+	a.mu300ApplyCallPoll([]parsedCall{setup}, now, true)
+	id := a.calls.Active.ID
+	a.mu300ApplyCallPoll(nil, now.Add(time.Second), true)
+	a.mu300ApplyCallPoll(nil, now.Add(6*time.Second), true)
+	if a.calls.Active == nil || a.calls.Active.ID != id || len(a.calls.History) != 0 {
+		t.Fatal("waiting for peer answer was prematurely reported ended")
+	}
+	setup.State = "active"
+	a.mu300ApplyCallPoll([]parsedCall{setup}, now.Add(8*time.Second), true)
+	if a.calls.Active.ID != id || a.calls.Active.State != "active" {
+		t.Fatal("answer changed outgoing identity")
+	}
+	// A real, sustained absence must still terminate; grace is not endless.
+	a.mu300ApplyCallPoll(nil, now.Add(9*time.Second), true)
+	a.mu300ApplyCallPoll(nil, now.Add(14*time.Second), true)
+	if a.calls.Active != nil || len(a.calls.History) != 1 {
+		t.Fatal("confirmed end was hidden")
+	}
+}
+
+func TestMU300PollFailureBreaksAbsenceConfirmation(t *testing.T) {
+	for _, response := range []string{"timeout", "+CLCC: malformed\nOK"} {
+		t.Run(response, func(t *testing.T) {
+			a := testMU300Calls(t, func(string, time.Duration) (string, error) {
+				if response == "timeout" {
+					return "", errors.New("timeout")
+				}
+				return response, nil
+			})
+			now := time.Now()
+			a.mu300ApplyCallPoll([]parsedCall{{Index: 1, Direction: "outgoing", State: "alerting"}}, now, true)
+			id := a.calls.Active.ID
+			a.mu300ApplyCallPoll(nil, now.Add(time.Second), true)
+			if _, e := a.mu300PollRefreshCalls(); e == nil {
+				t.Fatal("invalid poll accepted")
+			}
+			a.mu300ApplyCallPoll(nil, now.Add(time.Minute), true)
+			if a.calls.Active == nil || a.calls.Active.ID != id {
+				t.Fatal("time without reliable evidence counted as a confirmed end")
+			}
+		})
+	}
+}
+
+func TestMU300ControlDuringGapDoesNotEndOrRetarget(t *testing.T) {
+	mutations := 0
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		if command == "AT+CLCC" {
+			return "OK", nil
+		}
+		mutations++
+		return "OK", nil
+	})
+	a.mu300ApplyCallPoll([]parsedCall{{Index: 1, Direction: "outgoing", State: "alerting"}}, time.Now(), true)
+	id := a.calls.Active.ID
+	if e := a.hangupCallForID(id); e == nil {
+		t.Fatal("control accepted without a fresh target")
+	}
+	if mutations != 0 || a.calls.Active == nil || a.calls.Active.ID != id {
+		t.Fatal("failed control falsely ended the waiting call")
+	}
+}
+
+func TestMU300NewDialDuringGapCannotRedial(t *testing.T) {
+	mutations := 0
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		if command == "AT+CLCC" {
+			return "OK", nil
+		}
+		mutations++
+		return "OK", nil
+	})
+	a.mu300ApplyCallPoll([]parsedCall{{Index: 1, Direction: "outgoing", State: "dialing"}}, time.Now(), true)
+	id := a.calls.Active.ID
+	if _, e := a.mu300Dial("15550002222", "new-operation", ""); e == nil {
+		t.Fatal("second dial accepted")
+	}
+	if mutations != 0 || a.calls.Active == nil || a.calls.Active.ID != id {
+		t.Fatal("one missing snapshot allowed redial")
+	}
+}
+
+func TestMU300AnswerGapRetainsIdentity(t *testing.T) {
+	writes, polls := 0, 0
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		switch command {
+		case "AT+CLCC":
+			if writes == 0 {
+				return mu300TestWaiting + "OK", nil
+			}
+			polls++
+			if polls == 1 {
+				return "OK", nil
+			}
+			return mu300TestAnswered + "OK", nil
+		case "ATA":
+			writes++
+			return "OK", nil
+		default:
+			t.Fatalf("unexpected command %s", command)
+			return "", nil
+		}
+	})
+	_, _ = a.mu300RefreshCalls()
+	id := a.calls.Active.ID
+	if err := a.answerCallForID(id); err != nil {
+		t.Fatal(err)
+	}
+	if writes != 1 || a.calls.Active.ID != id || len(a.calls.History) != 0 {
+		t.Fatal("answer gap changed the identity or repeated ATA")
+	}
+}
+
+func TestMU300TargetedEndDoesNotRetireMissingPeer(t *testing.T) {
+	ended := false
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		switch command {
+		case "AT+CLCC":
+			if ended {
+				return "OK", nil
+			}
+			return mu300TestActive + mu300TestWaiting + "OK", nil
+		case "AT+CHLD=?":
+			return mu300TestCaps, nil
+		case "AT+CHLD=0":
+			ended = true
+			return "OK", nil
+		default:
+			t.Fatalf("unexpected command %s", command)
+			return "", nil
+		}
+	})
+	_, _ = a.mu300RefreshCalls()
+	peer, target := a.mu300Calls[1].ID, a.mu300Calls[2].ID
+	if err := a.rejectCallForID(target); err != nil {
+		t.Fatal(err)
+	}
+	if a.calls.Active == nil || a.calls.Active.ID != peer || len(a.calls.History) != 1 || a.calls.History[0].ID != target {
+		t.Fatal("targeted reject also retired an unobserved peer")
+	}
+}
+
+func TestMU300ControlRequiresFreshPeer(t *testing.T) {
+	a := testMU300Calls(t, func(command string, _ time.Duration) (string, error) {
+		if command != "AT+CLCC" {
+			t.Fatalf("missing peer permitted modem command %s", command)
+		}
+		return mu300TestWaiting + "OK", nil
+	})
+	a.mu300ApplyCallPoll(parseCLCC(mu300TestActive+mu300TestWaiting), time.Now(), true)
+	if err := a.answerCallForID(a.mu300Calls[2].ID); err == nil {
+		t.Fatal("missing peer permitted single-call ATA")
+	}
+	if len(a.mu300Calls) != 2 || len(a.calls.History) != 0 {
+		t.Fatal("preflight retired a missing peer")
+	}
+}
diff --git a/module/module-agent/mu300_sms.go b/module/module-agent/mu300_sms.go
new file mode 100644
index 0000000..fe207b3
--- /dev/null
+++ b/module/module-agent/mu300_sms.go
@@ -0,0 +1,422 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+)
+
+// Only read the native daemon's atomically written pool. In particular, do not
+// use `show` (marks read), sync, CMGF/CPMS or delete the SIM's/pool's messages.
+type mu300SMSBackend struct {
+	mu          sync.Mutex
+	sendMu      sync.Mutex
+	pool, state string
+	seen        map[string]bool
+	initialized bool
+	runSend     func(context.Context, string) (string, error)
+}
+
+var mu300PoolID = regexp.MustCompile(`^[0-9]{1,12}$`)
+var mu300SMSPhone = regexp.MustCompile(`^\+?[0-9]{1,20}$`)
+var mu300SentReply = regexp.MustCompile(`^sent \(reference [0-9]+\)$`)
+
+func newMU300SMSBackend(dataDir string) *mu300SMSBackend {
+	return &mu300SMSBackend{pool: "/etc/mu300/sms-pool/msg", state: filepath.Join(dataDir, "mu300-sms"), runSend: runMU300SMSSend}
+}
+
+func readMU300PrivateFile(path string, limit int64) ([]byte, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > limit {
+		return nil, errors.New("invalid SMS file")
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	actual, err := f.Stat()
+	if err != nil || !os.SameFile(info, actual) {
+		return nil, errors.New("SMS file changed; retry later")
+	}
+	b, err := io.ReadAll(io.LimitReader(f, limit+1))
+	if err != nil || int64(len(b)) > limit {
+		return nil, errors.New("SMS file exceeds limit")
+	}
+	return b, nil
+}
+
+func parseMU300PoolMessage(name string, data []byte) (storedSMS, bool, error) {
+	bad := errors.New("invalid native SMS pool entry")
+	header, body, ok := bytes.Cut(data, []byte("\n\n"))
+	if !ok || !utf8.Valid(data) {
+		return storedSMS{}, false, bad
+	}
+	h := map[string]string{}
+	for _, line := range strings.Split(string(header), "\n") {
+		k, v, valid := strings.Cut(line, ": ")
+		if !valid || h[k] != "" {
+			return storedSMS{}, false, bad
+		}
+		h[k] = v
+	}
+	if h["dir"] == "mo" {
+		return storedSMS{}, false, nil
+	}
+	if h["dir"] != "mt" || h["id"] != name || h["from"] == "" || len(h["from"]) > 256 {
+		return storedSMS{}, false, bad
+	}
+	n, err := strconv.Atoi(h["length"])
+	if err != nil || n < 1 || n > 65536 || len(body) != n+1 || body[n] != '\n' {
+		return storedSMS{}, false, bad
+	}
+	stamp, err := strconv.ParseInt(h["received"], 10, 64)
+	if err != nil || stamp <= 0 || stamp > 4102444800 {
+		return storedSMS{}, false, bad
+	}
+	content := string(body[:n])
+	// The native codec drops SCTS timezone. Use the unambiguous persisted receipt
+	// epoch instead of interpreting the sender's wall clock as UTC.
+	identity, _ := json.Marshal([]string{name, h["from"], h["scts"], h["received"], content})
+	digest := sha256.Sum256(identity)
+	message := smsMessage{Sender: h["from"], Content: content, Timestamp: time.Unix(stamp, 0).UTC(), DeliveryID: "mu300-" + hex.EncodeToString(digest[:])}
+	if code := verificationCodePattern.FindStringSubmatch(content); len(code) > 1 {
+		message.Code = code[1]
+	}
+	return storedSMS{Memory: "MU300_POOL", Message: message}, true, nil
+}
+
+func (b *mu300SMSBackend) snapshot() ([]storedSMS, error) {
+	d, err := os.Open(b.pool)
+	if err != nil {
+		return nil, errors.New("native SMS pool unavailable")
+	}
+	defer d.Close()
+	entries, err := d.ReadDir(10001)
+	if (err != nil && !errors.Is(err, io.EOF)) || len(entries) > 10000 {
+		return nil, errors.New("native SMS pool exceeds scan limit")
+	}
+	items := []storedSMS{}
+	total := 0
+	for _, entry := range entries {
+		if !mu300PoolID.MatchString(entry.Name()) {
+			continue
+		}
+		data, err := readMU300PrivateFile(filepath.Join(b.pool, entry.Name()), 69632)
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		} // native deletion during scan
+		if err != nil {
+			return nil, errors.New("cannot read native SMS pool")
+		}
+		total += len(data)
+		if total > 16<<20 {
+			return nil, errors.New("native SMS pool exceeds scan budget")
+		}
+		item, incoming, err := parseMU300PoolMessage(entry.Name(), data)
+		if err != nil {
+			return nil, err
+		}
+		if incoming {
+			items = append(items, item)
+		}
+	}
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].Message.Timestamp.Equal(items[j].Message.Timestamp) {
+			return items[i].Message.DeliveryID < items[j].Message.DeliveryID
+		}
+		return items[i].Message.Timestamp.After(items[j].Message.Timestamp)
+	})
+	return items, nil
+}
+
+func (b *mu300SMSBackend) loadAcks() (map[string]bool, error) {
+	ack := map[string]bool{}
+	data, err := readMU300PrivateFile(filepath.Join(b.state, "acks.json"), 8<<20)
+	if errors.Is(err, os.ErrNotExist) {
+		return ack, nil
+	}
+	if err != nil || json.Unmarshal(data, &ack) != nil || ack == nil || len(ack) > 50000 {
+		return nil, errors.New("SMS delivery state unavailable; preserved for recovery")
+	}
+	return ack, nil
+}
+
+func (b *mu300SMSBackend) save(name string, value any) error {
+	if err := os.MkdirAll(b.state, 0700); err != nil {
+		return errors.New("cannot save SMS state")
+	}
+	info, err := os.Lstat(b.state)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("invalid SMS state directory")
+	}
+	if err := os.Chmod(b.state, 0700); err != nil {
+		return err
+	}
+	data, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(b.state, ".state-*")
+	if err != nil {
+		return errors.New("cannot save SMS state")
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(f.Name(), filepath.Join(b.state, name))
+	}
+	if err == nil {
+		d, openErr := os.Open(b.state)
+		if openErr != nil {
+			return openErr
+		}
+		err = d.Sync()
+		d.Close()
+	}
+	if err != nil {
+		return errors.New("cannot durably save SMS state")
+	}
+	return nil
+}
+
+func (a *agent) mu300RefreshSMS() {
+	b := a.mu300SMS
+	if b == nil {
+		a.setSMSError(errors.New("native SMS backend unavailable"))
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	acks, err := b.loadAcks()
+	if err != nil {
+		a.setSMSError(err)
+		return
+	}
+	items, err := b.snapshot()
+	if err != nil {
+		a.setSMSError(err)
+		return
+	}
+	seen := make(map[string]bool, len(items))
+	pending := []storedSMS{}
+	push := []smsMessage{}
+	for _, item := range items {
+		id := item.Message.DeliveryID
+		seen[id] = true
+		if acks[id] {
+			continue
+		}
+		if len(pending) < 256 {
+			pending = append(pending, item)
+		}
+		// Do not flood an existing Relay registration with historical inbox items
+		// on initial startup. HTTP sync still delivers that history to the phone.
+		if b.initialized && !b.seen[id] {
+			push = append(push, item.Message)
+		}
+	}
+	b.seen, b.initialized = seen, true
+	a.mu.Lock()
+	changed := len(a.messages) != len(pending)
+	if !changed {
+		for i := range pending {
+			if a.messages[i].Message.DeliveryID != pending[i].Message.DeliveryID {
+				changed = true
+				break
+			}
+		}
+	}
+	a.messages, a.smsError = pending, ""
+	if changed {
+		a.smsRevision++
+		a.notifyAgentEventChangedLocked()
+	}
+	a.mu.Unlock()
+	for _, message := range push {
+		a.scheduleSMSPush(message)
+	}
+}
+
+func (a *agent) mu300SMSPollLoop() {
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		a.mu300RefreshSMS()
+		<-ticker.C
+	}
+}
+
+func (a *agent) mu300AckSMS(ids []string) (int, error) {
+	b := a.mu300SMS
+	if b == nil || len(ids) > 256 {
+		return 0, errors.New("invalid SMS acknowledgement")
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	acks, err := b.loadAcks()
+	if err != nil {
+		return 0, err
+	}
+	requested := map[string]bool{}
+	for _, id := range ids {
+		requested[id] = true
+	}
+	a.mu.RLock()
+	pending := append([]storedSMS(nil), a.messages...)
+	a.mu.RUnlock()
+	n := 0
+	for _, item := range pending {
+		id := item.Message.DeliveryID
+		if requested[id] {
+			if !acks[id] {
+				n++
+			}
+			acks[id] = true
+		}
+	}
+	if len(acks) > 50000 {
+		return 0, errors.New("SMS acknowledgement storage limit reached")
+	}
+	if n == 0 {
+		return 0, nil
+	}
+	if err := b.save("acks.json", acks); err != nil {
+		return 0, err
+	}
+	a.mu.Lock()
+	remaining := a.messages[:0]
+	for _, item := range a.messages {
+		if !acks[item.Message.DeliveryID] {
+			remaining = append(remaining, item)
+		}
+	}
+	a.messages = remaining
+	a.smsRevision++
+	a.notifyAgentEventChangedLocked()
+	a.mu.Unlock()
+	return n, nil
+}
+
+type mu300SMSSendState struct {
+	Fingerprint string `json:"fingerprint"`
+	Started     int64  `json:"started"`
+	Sent        bool   `json:"sent"`
+}
+
+func runMU300SMSSend(ctx context.Context, input string) (string, error) {
+	cmd := exec.CommandContext(ctx, "/opt/mu300/bin/mu300-sms", "send", "--stdin")
+	cmd.Stdin = strings.NewReader(input)
+	// Never surface native stdout/stderr: it can contain a number or message.
+	out, err := cmd.Output()
+	return string(out), err
+}
+
+func (a *agent) mu300SendSMS(phone, text string) (int, error) {
+	if !mu300SMSPhone.MatchString(phone) || !utf8.ValidString(text) || strings.TrimSpace(text) == "" || utf8.RuneCountInString(text) > 70 {
+		return 0, errors.New("MU300 SMS requires a valid number and 1-70 characters")
+	}
+	for _, r := range text {
+		if r > 0xffff || (r < 32 && r != '\n' && r != '\t') || r == 127 {
+			return 0, errors.New("MU300 SMS does not support emoji or control characters")
+		}
+	}
+	b := a.mu300SMS
+	if b == nil {
+		return 0, errors.New("native SMS backend unavailable")
+	}
+	if !b.sendMu.TryLock() {
+		return 0, errors.New("SMS submission in progress; do not repeat")
+	}
+	defer b.sendMu.Unlock()
+	// Serialize with call control and verify current radio state before sending.
+	a.mu300CallMu.Lock()
+	calls, err := a.mu300PollRefreshCalls()
+	a.mu300CallMu.Unlock()
+	if err != nil || len(calls) > 0 {
+		return 0, errors.New("finish calls before sending SMS; unknown call state blocks submission")
+	}
+	h := sha256.Sum256([]byte(phone + "\x00" + text))
+	state := mu300SMSSendState{Fingerprint: hex.EncodeToString(h[:]), Started: time.Now().Unix()}
+	previous, err := readMU300PrivateFile(filepath.Join(b.state, "send.json"), 4096)
+	if err == nil {
+		var old mu300SMSSendState
+		if json.Unmarshal(previous, &old) != nil {
+			return 0, errors.New("SMS submission state needs review")
+		}
+		if state.Started-old.Started < 120 && (!old.Sent || old.Fingerprint == state.Fingerprint) {
+			if old.Sent {
+				return 1, nil
+			}
+			return 0, errors.New("previous SMS outcome unknown; check recipient before retrying after two minutes")
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return 0, errors.New("SMS submission state unavailable")
+	}
+	// A restart or disconnected HTTP client must not cause an implicit retry.
+	if err := b.save("send.json", state); err != nil {
+		return 0, err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 70*time.Second)
+	defer cancel()
+	out, err := b.runSend(ctx, phone+"\n"+text)
+	if err != nil || !mu300SentReply.MatchString(strings.TrimSpace(out)) {
+		return 0, errors.New("SMS submission not confirmed; check recipient before retrying; no automatic resend")
+	}
+	state.Sent = true
+	if err := b.save("send.json", state); err != nil {
+		return 0, errors.New("SMS accepted by modem but receipt not saved; do not resend")
+	}
+	return 1, nil
+}
+
+func (a *agent) mu300SMSSendHTTP(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Phone      string `json:"phone"`
+		Message    string `json:"message"`
+		SIMAccount string `json:"sim_account,omitempty"`
+	}
+	if !decodeJSON(w, r, &body) {
+		return
+	}
+	if body.SIMAccount != "" && body.SIMAccount != "0" {
+		writeError(w, http.StatusBadRequest, "MU300 has one SIM; the selected SIM account is not supported")
+		return
+	}
+	n, err := a.mu300SendSMS(strings.TrimSpace(body.Phone), body.Message)
+	if err != nil {
+		writeError(w, http.StatusBadGateway, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"sent": true, "segments": n})
+}
+
+// fmt is used here to keep unsupported operations explicit in internal callers.
+func mu300SMSUnsupported(operation string) error {
+	return fmt.Errorf("MU300 SMS %s is not supported; native messages are preserved", operation)
+}
diff --git a/module/module-agent/mu300_sms_test.go b/module/module-agent/mu300_sms_test.go
new file mode 100644
index 0000000..c09ddb4
--- /dev/null
+++ b/module/module-agent/mu300_sms_test.go
@@ -0,0 +1,320 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func smsFixture(t *testing.T) *agent {
+	t.Helper()
+	dir := t.TempDir()
+	b := newMU300SMSBackend(dir)
+	b.pool = filepath.Join(dir, "pool")
+	if err := os.Mkdir(b.pool, 0700); err != nil {
+		t.Fatal(err)
+	}
+	a := &agent{profile: runtimeProfileFrom("mu300-openwrt"), mu300SMS: b, eventChanged: make(chan struct{}), callChanged: make(chan struct{})}
+	a.callControlCommand = func(command string, _ time.Duration) (string, error) {
+		if command != "AT+CLCC" {
+			t.Errorf("unexpected modem write: %s", command)
+		}
+		return "OK\r\n", nil
+	}
+	b.runSend = func(context.Context, string) (string, error) {
+		t.Error("unexpected SMS submit")
+		return "", errors.New("blocked")
+	}
+	return a
+}
+
+func writeSMSFixture(t *testing.T, a *agent, id, direction, content string) string {
+	t.Helper()
+	path := filepath.Join(a.mu300SMS.pool, id)
+	text := fmt.Sprintf("id: %s\ndir: %s\nstatus: unread\nfrom: TEST-SENDER\nscts: 2026-01-01 08:00:00\nreceived: 1767225600\nlength: %d\n\n%s\n", id, direction, len(content), content)
+	if err := os.WriteFile(path, []byte(text), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestMU300SMSInboxAckPersistsWithoutNativeMutation(t *testing.T) {
+	a := smsFixture(t)
+	path := writeSMSFixture(t, a, "000001", "mt", "fixture 123456\nsecond line")
+	writeSMSFixture(t, a, "000002", "mo", "outgoing fixture")
+	before, _ := os.ReadFile(path)
+	a.mu300RefreshSMS()
+	if a.smsError != "" || len(a.messages) != 1 || a.messages[0].Message.Code != "123456" {
+		t.Fatal("inbox mapping failed")
+	}
+	id := a.messages[0].Message.DeliveryID
+	if a.messages[0].Message.Timestamp.Format(time.RFC3339) != "2026-01-01T00:00:00Z" {
+		t.Fatal("receipt epoch misinterpreted")
+	}
+	n, err := a.mu300AckSMS([]string{id, "unknown"})
+	if err != nil || n != 1 || len(a.messages) != 0 {
+		t.Fatalf("ack: %d %v", n, err)
+	}
+	a.mu300RefreshSMS()
+	if len(a.messages) != 0 {
+		t.Fatal("acknowledged SMS redelivered")
+	}
+	restarted := smsFixture(t)
+	restarted.mu300SMS.pool = a.mu300SMS.pool
+	restarted.mu300SMS.state = a.mu300SMS.state
+	restarted.mu300RefreshSMS()
+	if restarted.smsError != "" || len(restarted.messages) != 0 {
+		t.Fatal("ack did not survive restart")
+	}
+	after, _ := os.ReadFile(path)
+	if string(before) != string(after) {
+		t.Fatal("native message changed")
+	}
+	info, _ := os.Stat(filepath.Join(a.mu300SMS.state, "acks.json"))
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("ack state not private")
+	}
+	// Reuse of an index must not acknowledge a different message.
+	writeSMSFixture(t, a, "000001", "mt", "replacement fixture")
+	a.mu300RefreshSMS()
+	if len(a.messages) != 1 || a.messages[0].Message.DeliveryID == id {
+		t.Fatal("index reuse lost new message")
+	}
+}
+
+func TestMU300SMSPoolRejectsIncompleteAndLinkedFiles(t *testing.T) {
+	for _, kind := range []string{"truncated", "symlink", "invalid-utf8"} {
+		t.Run(kind, func(t *testing.T) {
+			a := smsFixture(t)
+			path := writeSMSFixture(t, a, "000001", "mt", "fixture")
+			switch kind {
+			case "truncated":
+				os.WriteFile(path, []byte("id: 000001\ndir: mt\n\npartial"), 0600)
+			case "symlink":
+				os.Remove(path)
+				os.Symlink("/dev/null", path)
+			case "invalid-utf8":
+				os.WriteFile(path, []byte{255}, 0600)
+			}
+			a.mu300RefreshSMS()
+			if a.smsError == "" || len(a.messages) != 0 {
+				t.Fatal("invalid pool accepted")
+			}
+		})
+	}
+}
+
+func TestMU300SMSAckFailureRetainsDelivery(t *testing.T) {
+	a := smsFixture(t)
+	writeSMSFixture(t, a, "000001", "mt", "fixture")
+	a.mu300RefreshSMS()
+	id := a.messages[0].Message.DeliveryID
+	if err := os.MkdirAll(a.mu300SMS.state, 0700); err != nil {
+		t.Fatal(err)
+	}
+	os.WriteFile(filepath.Join(a.mu300SMS.state, "acks.json"), []byte("broken"), 0600)
+	if _, err := a.mu300AckSMS([]string{id}); err == nil {
+		t.Fatal("corrupt state overwritten")
+	}
+	if len(a.messages) != 1 {
+		t.Fatal("unpersisted ack removed message")
+	}
+	a.mu300RefreshSMS()
+	if a.smsError == "" {
+		t.Fatal("corrupt state hidden")
+	}
